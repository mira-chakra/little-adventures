# Copy to server/.env; never commit the real file.
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/littleadventures?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
NODE_ENV=development
# Only needed to create the first admin during `npm run seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
